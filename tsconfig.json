{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun-types", "node"],
    "baseUrl": ".",
    "paths": {
      "@agent-commons/core": ["packages/core/src/index.ts"],
      "@agent-commons/database": ["packages/database/src/index.ts"],
      "@agent-commons/security": ["packages/security/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".gemini"]
}
