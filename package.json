{
  "name": "agent-commons",
  "version": "0.1.0",
  "description": "Agent Commons: Collective Intelligence, Tripartite Memory Mesh & Immune Defense for AI Agents",
  "type": "module",
  "bin": {
    "agent-commons": "./bin/cli.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun run bin/cli.ts",
    "serve": "bun run bin/cli.ts serve",
    "doctor": "bun run bin/cli.ts doctor",
    "dev": "bun --watch packages/mcp-server/src/index.ts",
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bunx biome check .",
    "db:migrate": "bun run packages/database/src/migrate.ts",
    "install:skill": "bash install.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imMamdouhaboammar/agent-commons.git"
  },
  "bugs": {
    "url": "https://github.com/imMamdouhaboammar/agent-commons/issues"
  },
  "homepage": "https://github.com/imMamdouhaboammar/agent-commons#readme",
  "keywords": [
    "agent-skill",
    "skills-sh",
    "claude-code",
    "cursor",
    "codex",
    "gemini-cli",
    "antigravity",
    "mcp",
    "multi-agent",
    "decentralized-memory",
    "collective-intelligence",
    "immune-defense",
    "bun",
    "typescript"
  ],
  "author": "Mamdouh Aboammar <https://github.com/imMamdouhaboammar>",
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.4.0",
    "typescript": "^5.6.0"
  }
}
